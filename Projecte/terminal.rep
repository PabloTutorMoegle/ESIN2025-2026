/* Representació:
   - _n, _m, _h: Dimensions (fileres, places, pisos).
   - _st: Estratègia (FIRST_FIT o LLIURE). 
   - _graella: Matriu 3D de strings [filera][plaça][pis] que guarda la matrícula.
   - _espera: Llista de matrícules en espera. 
   - _on: Catàleg per saber la ubicació <i,j,k> de cada matrícula. 
   - _conts: Catàleg per guardar l'objecte contenidor (longitud). 
   - _ops_grua: Comptador d'operacions de grua.
*/

nat _n, _m, _h;
estrategia _st;
string*** _graella; 
list<string> _espera;
cataleg<ubicacio> _on;
cataleg<contenidor> _conts;
nat _ops_grua;

// Mètodes auxiliars privats
bool buscar_lloc(const contenidor &c, ubicacio &u) const;
bool es_pot_posar(nat f, nat p, nat k, nat ll) const;
void gestionar_espera();
void moure_a_espera(const string &m);
void col_locar_al_moll(const contenidor &c, const ubicacio &u);
void esborrar_del_moll(const string &m);
