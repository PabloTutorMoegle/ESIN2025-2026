nat n;  // número de fileres
nat m;  // número de places per filera
nat h;  // alçada màxima d'apilament
estrategia st;  // estratègia d'inserció i retirada
nat ops_grua_count = 0;  // contador de operacions de grua

// Estructura per emmagatzemar els contenidors a l'àrea d'emmagatzematge
// matriz[filera][plaça][altura] = contenidor o contenidor buit
// Usem un mapa para simplificar l'accés i la cerca
std::map<std::string, ubicacio> storage_map;  // mapeja matrícula a ubicació
std::map<ubicacio, contenidor> storage_grid;  // mapeja ubicació a contenidor

// Àrea d'espera per als contenidors
std::list<contenidor> waiting_area;

// Helper methods (mètodes privats)

// Comprova si existeix un contenidor amb la matrícula m a la terminal
bool exists(const string &m) const noexcept;

// Comprova si un contenidor està a l'àrea d'espera
bool is_in_waiting_area(const string &m) const noexcept;

// Intenta col·locar un contenidor a l'àrea d'emmagatzematge
// Retorna true si s'ha colocat correctament, false si no hi ha espai
bool place_in_storage(const contenidor &c) noexcept;

// Intenta retirar un contenidor de l'àrea d'emmagatzematge
// Retorna true si s'ha retirat correctament, false si no està a l'emmagatzematge
bool remove_from_storage(const string &m) noexcept;

// Retira un contenidor de l'àrea d'espera
void remove_from_waiting_area(const string &m) noexcept;

// Intenta moure contenidors de l'àrea d'espera a l'emmagatzematge
void move_from_waiting_area() noexcept;

// Obté la longitud d'un contenidor per la seva matrícula
nat get_container_length(const string &m) const noexcept;

// Obté la longitud d'un contenidor de l'àrea d'espera
nat get_container_length_from_waiting_area(const string &m) const noexcept;

// Obté el contenidor a una ubicació específica
string get_container_at_location(const ubicacio &u) const noexcept;

// Comprova si hi ha espai per a un contenidor en una posició
bool has_space_for_container(const contenidor &c, nat filera, nat plaça) const noexcept;

// Obté les ubicacions ocupades per un contenidor donada la seva matrícula
std::vector<ubicacio> get_container_locations(const string &m) const noexcept;

// Comparador per a ubicacions (necessari per usar a std::map)
struct UbicacioComparator {
    bool operator()(const ubicacio &a, const ubicacio &b) const {
        if (a.fila() != b.fila()) return a.fila() < b.fila();
        if (a.plaça() != b.plaça()) return a.plaça() < b.plaça();
        return a.altura() < b.altura();
    }
};
